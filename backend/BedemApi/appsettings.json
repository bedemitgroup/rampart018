{
  "_comment": "Secrets (connection string, JWT key) are NOT stored here. They come from the environment: ConnectionStrings__DefaultConnection, JwtSettings__SecretKey. Local development values live in appsettings.Development.json.",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "BedemApi",
    "Audience": "BedemApp"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ClientIp": {
    "ProviderHeader": "",
    "Strategy": "RightmostFromTrustedHops",
    "TrustedProxyHops": 1
  },
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "register": { "PermitLimit": 3, "Window": "01:00:00", "PartitionBy": "Ip" },
      "login": { "PermitLimit": 10, "Window": "00:15:00", "PartitionBy": "Ip" },
      "comments": { "PermitLimit": 5, "Window": "00:10:00", "PartitionBy": "Ip" },
      "problem-reports": { "PermitLimit": 3, "Window": "00:30:00", "PartitionBy": "Ip" },
      "membership-applications": { "PermitLimit": 2, "Window": "01:00:00", "PartitionBy": "Ip" },
      "votes": { "PermitLimit": 30, "Window": "00:01:00", "PartitionBy": "Ip" },
      "admin-writes": { "PermitLimit": 60, "Window": "00:01:00", "PartitionBy": "UserThenIp" },
      "assembly-live": { "PermitLimit": 20, "Window": "00:01:00", "PartitionBy": "UserThenIp" },
      "petition-sign": { "PermitLimit": 10, "Window": "01:00:00", "PartitionBy": "UserThenIp" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
