# Copy to .env and fill in. NEVER commit the real .env.
# Production: keep the filled file only at /opt/bedem/.env on the server and in
# a password manager. Generate every secret fresh per environment.

# PostgreSQL
POSTGRES_DB=bedem
POSTGRES_USER=bedem
# openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
POSTGRES_PASSWORD=

# pgAdmin (development only; not deployed in production)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# JWT
# openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=BedemApi
JWT_AUDIENCE=BedemApp

# Admin account. The schema seeds admin/Admin123!; on first boot the API
# replaces that password (and email) with these, then never touches them again.
# openssl rand -base64 18
SEED_ADMIN_EMAIL=admin@bedem018.rs
SEED_ADMIN_PASSWORD=

# Extra code a member must type, alongside their current password, to change
# their password or email. Not per-user - just a shared gate a stolen token
# alone cannot satisfy. Required for the API to start at all (dev and prod
# alike) - use a different value per environment.
# openssl rand -base64 18
PASSWORD_CHANGE_CODE=

# Public domain of the deployed site, e.g. bedem018.rs (no scheme).
# Used by Caddy for the TLS certificate.
SITE_DOMAIN=
