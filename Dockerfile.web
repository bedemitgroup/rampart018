# Production web tier: builds the SPA, then serves it with Caddy and reverse-
# proxies the API paths to the backend container. One image, one container.

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# VITE_API_BASE is left unset: the deployed app calls the API on its own origin.
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
